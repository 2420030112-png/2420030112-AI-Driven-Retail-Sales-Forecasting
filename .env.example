# NEXUS Frontend Configuration
# In development, leave blank or point to local backend (Vite proxies /api to http://127.0.0.1:8000)
# In production, set to your deployed backend origin (e.g. https://api.nexus-demand.com)
VITE_API_URL=http://127.0.0.1:8000

# NEXUS Backend Configuration
NEXUS_ENV=development
NEXUS_API_HOST=127.0.0.1
NEXUS_API_PORT=8000
NEXUS_REQUEST_TIMEOUT_SEC=30.0
NEXUS_ARTIFACTS_DIR=artifacts/models

# Allowed CORS Origins (comma-separated list for production; defaults to localhost dev ports if empty)
# Example production: NEXUS_CORS_ORIGINS=https://app.nexus-demand.com,https://staging.nexus-demand.com
NEXUS_CORS_ORIGINS=
